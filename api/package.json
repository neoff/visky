{
  "name": "visky-api",
  "version": "1.5.1-alpha.1",
  "description": "Api for vk music",
  "main": "src/index.ts",
  "author": "en.varg",
  "license": "MIT",
  "scripts": {
    "generate:back": "apigen-ts http://127.0.0.1:8082/v3/api-docs ./src/rest/api-client.ts",
    "generate:catalog": "apigen-ts https://catalog-service-prod.mac.yc.mvideo.ru/contracts/api.yaml ./src/rest/api-catalog.ts",
    "generate:api": "npx openapi-typescript-codegen --input ./docs/openapi.yaml --output ./src/__genedated__/openapi/vk --useOptions --client axios",
    "generate:all": "yarn generate:api && yarn generate:back && yarn generate:catalog",
    "generate": "yarn generate:api",
    "dev": "tsx watch src/index.ts",
    "build": "yarn generate && yarn test && node esbuild.config.mjs",
    "test": "jest --coverage",
    "lint": "eslint .",
    "prune": "npm prune --production",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "axios-cookiejar-support": "^5.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-openapi": "^12.1.3",
    "express-session": "^1.18.1",
    "node-fetch": "^3.3.2",
    "passport": "^0.7.0",
    "passport-vkontakte": "^0.5.0",
    "pg": "^8.16.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tough-cookie": "^5.0.0",
    "typeorm": "^0.3.24",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/axios": "^0.14.4",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-vkontakte": "^1.3.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/tough-cookie": "^4.0.5",
    "@types/yamljs": "^0.2.34",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "apigen-ts": "^1.2.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "jest": "^29.7.0",
    "openapi-typescript-codegen": "^0.29.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "repository": "git@github.com:neoff/visky-api.git",
  "private": true
}
