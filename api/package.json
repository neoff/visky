{
  "name": "vk-friski-api",
  "version": "1.0.19",
  "description": "Api for vk music",
  "main": "index.js",
  "author": "EN.varg",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev --respawn --pretty --transpile-only --project tsconfig.json --require tsconfig-paths/register src/index.ts",
    "build": "esbuild src/index.ts --external:deasync --platform=node --bundle --minify --outfile=dist/index.js",
    "start": "ts-node dist/index.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "axios-cookiejar-support": "^5.0.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "passport": "^0.7.0",
    "passport-vkontakte": "^0.5.0",
    "tough-cookie": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/axios": "^0.14.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.5.5",
    "@types/passport": "^1.0.16",
    "@types/passport-vkontakte": "^1.3.5",
    "@types/tough-cookie": "^4.0.5",
    "esbuild": "^0.23.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
