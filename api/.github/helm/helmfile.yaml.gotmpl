repositories:
  - name: stable
    url: https://charts.helm.sh/stable

helmDefaults:
  atomic: true  # Auto-rollback on failure
  timeout: 300  # 5 minutes timeout for deployment

environments:
  production:
    values:
      []
---
releases:
  - name: {{ env "REPO_NAME" }}
    # Dynamic namespace support via NAMESPACE env var
    # Usage: NAMESPACE=frisky REPO_NAME=visky-api helmfile apply
    # Default: "default" if NAMESPACE not set
    # Current deployment: frisky namespace (as of Dec 2025)
    namespace: {{ env "NAMESPACE" | default "default" }}
    chart: ./
    values:
      - values.yaml