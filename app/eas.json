{
	"cli": {
		"appVersionSource": "remote"
	},
	"build": {
		"base": {
			"node": "22.13.0",
			"distribution": "internal",
			"autoIncrement": true,
			"android": {
				"buildType": "apk",
				"ndk": "26.3.11579264",
				"image": "ubuntu-22.04-jdk-17-ndk-r26b"
			},
			"ios": {
				"simulator": true
			},
			"env": {
				"EXPO_PUBLIC_LPI_URL": "http://localhost:3000",
				"EXPO_PUBLIC_LPI_ANDROID_URL": "http://10.0.2.2:3000",
				"EXPO_PUBLIC_API_URL": "https://visky.envarg.com",
				"EXPO_PUBLIC_DEV": "false"
			}
		},
		"development": {
			"extends": "base",
			"developmentClient": true
		},
		"preview": {
			"extends": "base"
		},
		"production": {
			"extends": "base",
			"distribution": "store",
			"android": {
				"buildType": "app-bundle"
			}
		}
	},
	"submit": {
		"production": {
			"android": {
				"track": "internal"
			}
		}
	}
}
