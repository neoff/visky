{
  "expo": {
    "name": "visky",
    "slug": "visky",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "visky",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.envarg.visky",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "visky"
        ],
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "localhost": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "frisky.envarg.com": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "exp.direct": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "ndkVersion": "26.3.11579264",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000"
      },
      "package": "com.envarg.visky"
    },
    "web": {
      "bundler": "webpack",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "db8e9c8f-c68f-45fd-b4a1-bff0ca4f7c4d"
      }
    }
  },
  "android": {
    "package": "com.envarg.reacttestapp"
  },
  "ios": {
    "bundleIdentifier": "com.envarg.example.ReactTestApp"
  },
  "macos": {
    "bundleIdentifier": "com.envarg.ReactTestApp"
  }
}
